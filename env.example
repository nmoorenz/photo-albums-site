# Copy to .env and fill in. .env is gitignored -- never commit real values.
# This is the only place your own names live: scripts/tf.py feeds them to
# terraform as TF_VAR_*, and album_sync.py and deploy_site.sh read the same
# file.
S3_BUCKET=your-photo-albums-bucket
DOMAIN_NAME=albums.example.com
COGNITO_DOMAIN_PREFIX=your-albums
AWS_PROFILE=default

# Optional. Overrides the default in infrastructure/terraform.tfvars.
AWS_REGION=ap-southeast-6
